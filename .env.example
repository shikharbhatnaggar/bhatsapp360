APP_NAME=Bhatsapp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bhatsapp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Graph API defaults. Per-tenant credentials live in the whatsapp_accounts table.
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_GRAPH_URL=https://graph.facebook.com

# Sandbox mode simulates Graph API responses so the MVP is fully clickable
# without a live WABA. Set to false once real credentials are saved.
WHATSAPP_SANDBOX=true
WHATSAPP_SANDBOX_APPROVAL_DELAY=30
